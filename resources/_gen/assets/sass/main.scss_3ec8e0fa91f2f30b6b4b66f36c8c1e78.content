serif!important;background-image:linear-gradient(45deg,#b8b8b8 25%,transparent 25%),linear-gradient(-45deg,#b8b8b8 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#b8b8b8 75%),linear-gradient(-45deg,transparent 75%,#b8b8b8 75%)!important;background-size:4px 4px!important;background-position:0 0,0 2px,2px -2px,-2px 0!important;-webkit-font-smoothing:auto!important}*,*::before,*::after{border-radius:0!important}::selection{color:#fff;background:var(--retro-title)}a,.post-item-title a,.footer a,.page-content a{color:var(--retro-link)!important;text-decoration:underline!important;text-decoration-color:initial!important;transition:none!important}a:visited{color:var(--retro-link-visited)!important}a:hover,a:active{color:var(--retro-link-hover)!important}a:focus-visible,button:focus-visible,select:focus-visible,summary:focus-visible{outline:2px dotted #000!important;outline-offset:2px!important}h1,h2,h3,h4,.author-name,.header-title{font-family:arial black,Impact,Haettenschweiler,sans-serif!important;color:#000!important}code,pre,time,.post-meta,.retro-counter,.retro-label{font-family:courier new,Courier,monospace!important}strong,b{color:#000!important}hr,.retro-hr{border:0!important;height:4px!important;background:linear-gradient(to bottom,#808080 0 50%,#fff 50% 100%)!important}.retro-outset,.navbar,.footer,.toc,.retro-window,.retro-button,.archive-tags .tag-item,#totop{border:2px solid!important;border-color:#fff gray gray #fff!important;box-shadow:inset -1px -1px #404040,inset 1px 1px #dfdfdf!important;background:var(--retro-bg)!important}.retro-inset,.retro-window-body,.retro-counter,.retro-article-body,pre,blockquote{border:2px solid!important;border-color:gray #fff #fff gray!important;box-shadow:inset 1px 1px #404040,inset -1px -1px #dfdfdf!important}.retro-titlebar{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:22px;padding:4px 8px;color:#fff!important;font-weight:700;line-height:1.2;background:linear-gradient(to right,var(--retro-title),var(--retro-title-end))}.retro-titlebar span,.retro-titlebar a,.retro-titlebar .header-title{color:#fff!important;text-decoration:none!important}.retro-titlebar .header-title{margin:0!important;font-family:ms sans serif,segoe ui,Tahoma,Geneva,Verdana,sans-serif!important;font-size:clamp(1.35rem,3vw,2rem)!important;line-height:1.2!important}.retro-titlebar-buttons{display:inline-flex;gap:3px;flex:none}.retro-titlebar-buttons i{display:block;width:13px;height:13px;background:silver;border:2px solid;border-color:#fff gray gray #fff;box-shadow:inset -1px -1px #404040,inset 1px 1px #dfdfdf}.retro-window{margin:16px auto}.retro-window-body{margin:8px;padding:14px;background:#fff}.retro-window-body.retro-panel-yellow,.retro-article-body{background:var(--retro-panel)}.retro-button,.menu-link,.lang-list,#mode,#totop{display:inline-block;padding:4px 8px!important;color:#000!important;font-weight:700;text-decoration:none!important;text-transform:uppercase;background:var(--retro-bg)!important}.retro-button:active,.menu-link:active,.lang-list:active,#mode:active,#totop:active{border-color:gray #fff #fff gray!important;box-shadow:inset 1px 1px #404040,inset -1px -1px #dfdfdf!important;transform:translate(1px,1px)!important}.navbar{margin-top:12px!important;padding:6px!important;border-bottom:2px solid!important}.logo svg,.footer_social-icons svg{color:#000!important;stroke-width:2px}#mode{display:none!important}.lang-list{appearance:auto;font:700 12px ms sans serif,Tahoma,sans-serif;border:2px solid!important;border-color:gray #fff #fff gray!important;box-shadow:inset 1px 1px #404040,inset -1px -1px #dfdfdf!important}.wrapper{max-width:920px!important}.author{margin-top:28px!important;margin-bottom:22px!important;padding:0!important}.author-name,.retro-hero-title{margin:0;font-size:clamp(2.1rem,8vw,5.4rem)!important;line-height:.95!important;text-transform:uppercase;text-shadow:2px 2px 0 gray}.retro-rainbow{animation:retro-rainbow 4s linear infinite}.author-bio,