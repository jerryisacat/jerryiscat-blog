0f}.retro-color-squares span:nth-child(6){background:#0ff}.retro-construction{padding:8px;color:#000;font-weight:900;text-align:center;text-transform:uppercase;background:repeating-linear-gradient(45deg,#ffff00,#ffff00 10px,#000 10px,#000 20px)}.retro-construction span{display:inline-block;padding:4px 8px;background:#ff0;border:2px solid #000}.post .header{margin-top:24px;margin-bottom:0}.retro-article-window{max-width:860px}.retro-article-body{margin:8px;padding:clamp(16px,3vw,28px);color:#000;font-size:17px;line-height:1.72}.retro-article-body p,.retro-article-body ul,.retro-article-body ol,.retro-article-body blockquote,.retro-article-body pre{margin-top:1rem;margin-bottom:1rem}.retro-article-body h2,.retro-article-body h3,.retro-article-body h4{margin-top:1.6rem;padding:4px 8px;background:#fff;border:2px solid;border-color:#fff gray gray #fff;box-shadow:inset -1px -1px #404040,inset 1px 1px #dfdfdf}.toc{max-width:860px;margin:10px auto!important;padding:8px 12px!important;background:#ffc!important}.toc summary{cursor:pointer}blockquote{padding:10px 14px!important;margin-left:0!important;margin-right:0!important;color:#000!important;background:#fff!important;opacity:1!important}pre{padding:12px!important;background:#000!important;color:var(--retro-green)!important;overflow-x:auto}code{color:#000!important;background:#ff0!important;border:1px solid gray;padding:0 3px}pre code{color:var(--retro-green)!important;background:0 0!important;border:0}.footer{max-width:860px;margin:32px auto 24px!important;padding:12px!important;background:var(--retro-bg)!important}.footer_copyright{color:#000!important;opacity:1!important}@media screen and (max-width:768px){.navbar .menu{background:var(--retro-bg)!important;border-bottom:2px solid gray!important}.retro-post-row{grid-template-columns:1fr}.retro-post-date{text-align:left}.retro-marquee-track{animation-duration:24s}}@media(prefers-reduced-motion:reduce){.retro-rainbow,.retro-marquee-track,.retro-hot,.retro-new{animation:none!important}.retro-rainbow{color:red!important}}html{scroll-behavior:smooth}#totop{visibility:hidden;color:#434648;position:fixed;bottom:60px;right:30px;z-index:1;border-radius:10%;background-color:#dfe0e397;transition:visibility .5s,opacity .8s linear}#totop:hover{background-color:#dfe0e3}#totop svg{margin:auto;display:block;height:40px;width:40px}